flowchart TB
    subgraph untrusted["Untrusted: outside the system"]
        tenantClient["Tenant client<br/>X-Tenant-Id + Idempotency-Key"]
    end
    operator["Operator<br/>compose up, health probes, logs<br/>extraction budgets, kill-switch, revocations<br/>browser console: job state, chain, replay"]
    subgraph anvil["ANVIL: one Spring Boot deployable"]
        api["API service<br/>auth, validate, CBOR, submit, reads, audit, replay, health, extraction"]
        console["Operator console<br/>static React + TypeScript bundle served by the app<br/>same X-Tenant-Id scoping<br/>generic not found"]
        workers["Workers: library code, nothing starts them yet<br/>claim, heartbeat, commit, relay, reconcile"]
        cli["Operator CLI, AnvilCli<br/>own process, no Spring context<br/>replay, export, verify"]
        subgraph jailZone["Untrusted code: tenant-supplied execution"]
            jail["Exec jail<br/>bwrap namespaces: own workspace only, private /tmp, no network"]
        end
    end
    subgraph tenantData["Tenant boundary: enforced by Postgres RLS"]
        postgres["PostgreSQL 18<br/>source of truth, queue, outbox, audit chain"]
    end
    casStore["CAS store<br/>per-tenant content, hash-verified reads"]
    execWorkspaces["Exec workspaces<br/>per-tenant writable directories"]
    network["Network<br/>egress denied by default"]
    llm["Model provider<br/>DeepSeek chat completions API"]
    exports["Exported chains<br/>anvil-chain/1 JSON files"]
    broker["JailEgress broker<br/>in the parent: allowlist, connect-time DNS check"]
    tenantClient -->|"TRUST BOUNDARY: X-Tenant-Id checked, input validated"| api
    operator -->|probes, logs| api
    operator -->|"browser: job state, chain, replay"| console
    console -->|"same-origin: /api/jobs, /audit/events, /audit/replay"| api
    operator -->|"replay, export, verify"| cli
    cli -->|"JDBC read-only, as anvil_app, SET LOCAL app.tenant + RLS"| postgres
    cli -->|"export: never overwrites"| exports
    exports -.->|"TRUST BOUNDARY: verify reads the file as untrusted input, no database"| cli
    operator -->|"SQL: extraction budgets, kill-switch, revocations"| postgres
    api -->|"JDBC, SET LOCAL app.tenant + RLS (Compose login bypasses RLS, record 0018)"| postgres
    workers -.->|"claim, heartbeat, commit, relay, reconcile under RLS (no running caller yet)"| postgres
    api -.->|"put and get, torn tails removed (no route yet)"| casStore
    api -.->|"TRUST BOUNDARY: HTTPS, first 500 chars of a document out; reply is untrusted and checked"| llm
    workers -.->|"put and link, refcount GC (no running caller yet)"| casStore
    workers -.->|"TRUST BOUNDARY: run tenant argv, env, timeout (no production caller yet)"| jail
    jail -->|"own tenant's workspace only: bind mount at /work, resolveInWorkspace"| execWorkspaces
    jail -.->|"TRUST BOUNDARY: empty network namespace, no route"| network
    workers -.->|"egress on the jail's behalf (no production caller yet)"| broker
    broker -.->|"TRUST BOUNDARY: vetted address only, redirects denied"| network
