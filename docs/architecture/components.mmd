flowchart TB
    client["Tenant client<br/>X-Tenant-Id + Idempotency-Key"]
    pg["PostgreSQL 18<br/>RLS FORCE + tenant context"]
    cas["CAS store<br/>tenants/tenant/sha"]
    ws["Exec workspaces<br/>per-tenant writable dirs"]
    llm["Model provider<br/>DeepSeek chat completions over HTTPS<br/>configured base URL, key from env"]

    subgraph api["API service"]
        filter["TenantAuthFilter<br/>X-Tenant-Id check + TenantContext"]
        submitCtrl["SubmitController<br/>POST documents - 202 IDs"]
        submitSvc["SubmitService<br/>validate + canonical CBOR + one txn"]
        searchCtrl["DocumentSearchController<br/>GET documents query limit cursor"]
        readSvc["ReadService<br/>direct-ID + title-prefix + recheck"]
        auditCtrl["AuditEventsController<br/>GET audit events job limit cursor"]
        auditRead["AuditReadService<br/>caller-tenant chain ORDER BY seq"]
        replay["ReplayService + ReplayController<br/>load in the tenant, then evaluate<br/>input_sha + output_sha + match"]
        casPre["CasPresignedService<br/>HMAC URLs TTL 60s"]
        extractCtrl["ExtractionController<br/>POST documents id extract, GET documents id facts<br/>same 404 for forged, missing, other tenant"]
        extractSvc["ExtractionService<br/>screens, then kill-switch, tenant cache, budget, model<br/>one result per tenant + version + prompt + model<br/>revoked never served"]
        extractor["Extractor, the one path<br/>BoundedText 500 chars, one model call<br/>CitationCheck exact substring, quarantine"]
        rules["RulesBaseline fallback<br/>frozen regex, no model call<br/>same checks, marked fallback"]
        adapter["DeepSeekExtractionModel<br/>JSON mode, deadline over the whole reply<br/>1 MiB cap, retries with backoff"]
        observe["ObserveController<br/>saturation JSON + metrics text"]
        health["HealthController<br/>healthz readyz + correlation"]
    end

    subgraph cliProc["Operator CLI, AnvilCli: own process, no Spring context"]
        replayCmd["replay<br/>prints the API's body, exit 0 match, 1 not"]
        exportCmd["export<br/>never overwrites a file"]
        verifyCmd["verify<br/>no database connection"]
        restrict["read-only session<br/>RLS-bypassing login becomes anvil_app<br/>tenant must exist"]
        chainExport["ChainExport anvil-chain/1<br/>strict parse, 8 MiB cap, no lone surrogates"]
        offline["OfflineVerifier<br/>seq order, tenant scope, evaluate<br/>input_sha and state bound to the chain<br/>first bad seq"]
    end
    exportFile["Exported chain file"]

    subgraph workers["Workers"]
        claim["JobService claim + claimNext<br/>tenant lock + quota, order by penalty, next_run_at<br/>LIMIT 20 SKIP LOCKED + token"]
        beat["JobService heartbeat<br/>owner token live lease"]
        commit["JobService commit<br/>cap gate + fenced write"]
        recon["JobService reconciler<br/>expire to QUEUED or DEAD"]
        cap["JobService caps<br/>issue revoke FOR UPDATE"]
        timeline["TimelineGuard + confirmTimeline<br/>refuse on unknown or rewound timeline"]
        relay["OutboxRelay<br/>poll unsent LIMIT 100 + mark sent"]
        consumer["IdempotentConsumer<br/>processed_events dedup"]
        chain["AuditChain append<br/>same txn as effect<br/>checkpoint every 100"]
        store["ContentStore<br/>tmp fsync rename + refcount GC"]
        signals["SaturationSignals + BurnAlerts<br/>queue age, claim p99, pool wait p99"]
    end

    subgraph jail["Exec jail"]
        run["ExecJail run<br/>argv checks + tenant lock, launch sandbox"]
        sandbox["bwrap sandbox<br/>user, mount, pid, net namespaces<br/>own workspace at /work, private /tmp, no route"]
        resolve["resolveInWorkspace<br/>deny absolute dotdot encoded symlink"]
        env["clean env<br/>PATH + ANVIL_TENANT only"]
        caps["output caps<br/>1MiB stdout stderr + timeout 30s"]
        egress["JailEgress broker, in the parent<br/>allowlist, decoded IPs, re-resolve at connect<br/>pinned address, redirects denied"]
    end

    client --> filter
    filter --> submitCtrl --> submitSvc
    filter --> searchCtrl --> readSvc
    filter --> auditCtrl --> auditRead
    filter --> replay
    filter --> extractCtrl --> extractSvc --> extractor
    extractor -->|"BoundedText"| adapter
    extractor -->|"kill-switch, no budget, revoked"| rules
    adapter -->|"TRUST BOUNDARY: 500 chars out, reply checked before use"| llm
    extractSvc -->|"facts, dead letters, cache lookup, budget spend, switch read, JDBC SET LOCAL + RLS"| pg
    submitSvc -->|JDBC SET LOCAL + RLS| pg
    readSvc -->|JDBC SET LOCAL + RLS| pg
    auditRead -->|JDBC SET LOCAL + RLS| pg
    replay -->|chain + checkpoints, read-only| pg
    replayCmd --> restrict
    exportCmd --> restrict
    restrict -->|"ReplayService load + evaluate"| replay
    exportCmd --> chainExport
    chainExport -->|write| exportFile
    verifyCmd -->|read, untrusted| chainExport
    chainExport --> offline
    offline -->|"ReplayService.evaluate only"| replay
    casPre -->|authorize fetch| pg
    casPre -->|signed get| cas
    health -->|SELECT 1| pg
    submitSvc --> chain

    claim -->|SELECT UPDATE| pg
    beat -->|fenced UPDATE| pg
    commit -->|cap check + UPDATE| pg
    recon -->|reclaim deaden| pg
    cap -->|cap_grants| pg
    claim --> timeline
    beat --> timeline
    commit --> timeline
    timeline -->|db_timeline vs pg_control| pg
    relay -->|poll mark| pg
    relay --> consumer
    consumer -->|INSERT ON CONFLICT| pg
    claim --> chain
    commit --> chain
    cap --> chain
    store --> chain
    chain -->|SELECT+INSERT only| pg
    store -->|artifacts row| pg
    store --> cas
    claim -->|timing only| signals
    signals -->|oldest QUEUED on DB clock| pg
    signals --> observe

    claim -.->|no production caller yet| run
    run --> resolve
    run --> env
    run --> caps
    run --> sandbox
    sandbox -->|bind mount, own tenant only| ws
    sandbox -.->|"no network, egress only via the parent"| egress
    resolve -->|tenant root only| ws
