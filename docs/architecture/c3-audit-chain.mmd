flowchart TB
    submit["SubmitService<br/>validate + canonical CBOR + one txn"]
    claim["JobService claim/commit<br/>fenced token + cap gate + reconciler"]
    chain["AuditChain append<br/>same txn as effect<br/>checkpoint every 100"]
    pg["audit_events<br/>UNIQUE seq + prev_hash fork guard<br/>immutable trigger + RLS"]
    ckpt["job_checkpoints<br/>every 100 seq event_hash<br/>immutable trigger + RLS"]
    readapi["AuditReadService<br/>caller-tenant chain ORDER BY seq"]
    replay["Replay endpoint<br/>input_sha + output_sha + match"]
    submit -->|submit event| chain
    claim -->|claim commit cap cas events| chain
    chain -->|SELECT+INSERT only| pg
    chain -->|SELECT+INSERT only| ckpt
    pg -->|WHERE tenant job RLS + recheck| readapi
    pg -->|WHERE tenant job RLS + recheck| replay
    ckpt -->|latest le max_seq| replay
    readapi -->|clean chain| replay
