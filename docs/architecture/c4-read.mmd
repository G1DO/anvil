classDiagram
    class DocumentSearchController {
        +search() List
    }
    class ReadService {
        +getDocument() Optional
        +getVersion() Optional
        +getJob() Optional
        +searchDocuments() List
        +recheck() boolean
    }
    class TenantGuard {
        +setTenant() void
    }
    class TenantAuthFilter {
        +doFilter() void
    }
    class TenantContext {
        +get() String
        +set() void
    }
    DocumentSearchController --> ReadService
    ReadService --> TenantGuard
    TenantAuthFilter --> TenantContext
    DocumentSearchController --> TenantContext
