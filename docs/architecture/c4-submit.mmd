classDiagram
    class SubmitController {
        +submit() SubmitResponse
    }
    class SubmitService {
        +submit() SubmitResult
        -insertInTransaction() SubmitResult
        -findExisting() SubmitResult
    }
    class SubmitRequest {
        +title() String
        +mimeType() String
        +body() String
    }
    class SubmitResponse {
        +docId() UUID
        +versionId() UUID
        +jobId() UUID
    }
    class CanonicalCbor {
        +encode() Encoded
        +encodeMap() bytes
    }
    class AuditChain {
        +append() void
    }
    class TenantGuard {
        +setTenant() void
    }
    SubmitController --> SubmitService
    SubmitController --> SubmitRequest
    SubmitController --> SubmitResponse
    SubmitService --> CanonicalCbor
    SubmitService --> AuditChain
    SubmitService --> TenantGuard
