# Names the local stack reads. Copy to .env (untracked) to override; never commit values.
# Postgres password for docker compose; defaults to a local-only value when unset.
POSTGRES_PASSWORD=
# Model credential for AI extraction (record 0022). Unset: extraction answers 503 and calls no model.
ANVIL_MODEL_API_KEY=
# Optional overrides of the model and its base URL (defaults: deepseek-flash, https://api.deepseek.com).
# ANVIL_MODEL=deepseek-flash
# ANVIL_MODEL_BASE_URL=https://api.deepseek.com
